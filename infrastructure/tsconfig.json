{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "commonjs",
    "moduleResolution":"node",
    "lib":             ["es2020"],
    "strict":          true,
    "esModuleInterop": true,
    "outDir":          "./",
    "rootDir":         "./",
    "declaration":     true,
    "skipLibCheck":    true
  },
  "exclude": ["node_modules", "cdk.out"]
}
